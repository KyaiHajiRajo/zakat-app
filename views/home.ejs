      .btn-ghost:hover { background: rgba(255,255,255,.22); }
      .btn-line { color: var(--ink-2); background: var(--surface); border-color: var(--line-strong); }
      .btn-line:hover { border-color: var(--primary); color: var(--primary-dark); }
      .btn-wa { color: #fff; background: linear-gradient(135deg, #25d366, #128c7e); }
