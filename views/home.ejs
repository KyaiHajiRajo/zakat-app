      .brand img { width: 42px; height: 42px; padding: 5px; border-radius: 13px; background: #fff; object-fit: contain; box-shadow: 0 6px 16px -8px rgba(0,0,0,.4); flex: none; }
      .brand b { display: block; font-size: 1.02rem; font-weight: 800; line-height: 1.1; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .brand small { display: block; font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: #f1dca6; }
      .nav.is-solid .brand b { color: var(--ink); }
      .nav.is-solid .brand small { color: var(--gold-ink); }
