        try { theme = localStorage.getItem("app-theme"); } catch (e) {}
        var dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && dark)) { document.documentElement.classList.add("dark-mode"); }
      })();
    </script>
    <style>
      :root {
        --primary: #1eaf2f; --primary-dark: #14912a; --primary-darker: #0c6b1e; --forest: #0a4d1d;
        --gold: #c9a24b; --gold-soft: #f5edd8; --gold-ink: #86671a;
        --ink: #0f1a14; --ink-2: #36443b; --muted: #66766b; --faint: #9aa9a0;
        --bg: #f2f6f3; --surface: #fff; --surface-2: #f7faf8; --line: #e5ebe7; --line-strong: #d5ded8;
        --shadow-sm: 0 1px 2px rgba(15,26,20,.04), 0 2px 8px rgba(15,26,20,.05);
        --shadow-md: 0 2px 4px rgba(15,26,20,.04), 0 14px 30px -10px rgba(15,26,20,.14);
        --shadow-lg: 0 4px 8px rgba(15,26,20,.05), 0 28px 56px -16px rgba(15,26,20,.22);
        --wrap: 1180px;
      }
      html.dark-mode {
        --ink: #f1f5f9; --ink-2: #cbd5e1; --muted: #94a3b8; --faint: #64748b;
        --bg: #070c18; --surface: #0f172a; --surface-2: #111c33; --line: #1e293b; --line-strong: #2b3a52;
        --gold-soft: rgba(201,162,75,.14); --gold-ink: #dcbc6a;
        --shadow-sm: 0 1px 2px rgba(0,0,0,.3); --shadow-md: 0 14px 30px -10px rgba(0,0,0,.55); --shadow-lg: 0 28px 56px -16px rgba(0,0,0,.7);
        color-scheme: dark;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; scroll-padding-top: 76px; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.55; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      button { font: inherit; }
      .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 20px; }
      .sec { padding: 64px 0; }
      .sec-head { max-width: 640px; margin-bottom: 30px; }
      .eyebrow { display: inline-flex; gap: 8px; align-items: center; font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--primary-dark); }
      .eyebrow::before { content: ""; width: 22px; height: 2px; background: var(--gold); border-radius: 2px; }
      html.dark-mode .eyebrow { color: #6ee37e; }
