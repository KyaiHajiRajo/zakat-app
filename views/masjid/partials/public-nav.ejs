<%#
  Navigasi halaman publik (untuk jamaah, tanpa login). Dipakai di: Jadwal Ramadan, Info, Donasi, Transparansi.
  Parameter: settings, active ('ramadan' | 'info' | 'donasi' | 'transparansi')
%>
<%
  const pnLinks = [
    { key: 'ramadan', href: '/jadwal-ramadan', icon: 'fa-moon', label: 'Jadwal Ramadan' },
    { key: 'info', href: '/info-masjid', icon: 'fa-bullhorn', label: 'Info & Agenda' },
    { key: 'donasi', href: '/donasi', icon: 'fa-hand-holding-heart', label: 'Donasi' },
    { key: 'transparansi', href: '/transparansi', icon: 'fa-chart-pie', label: 'Laporan Kas' }
  ];
%>
<style>
  .pn-bar { position: sticky; top: 0; z-index: 60; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid var(--line); }
  .pn-in { max-width: 1180px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 14px; }
  .pn-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; flex: none; }
  .pn-brand img { width: 38px; height: 38px; object-fit: contain; padding: 4px; border-radius: 12px; background: #fff; border: 1px solid var(--line); }
  .pn-brand b { display: block; font-size: .95rem; line-height: 1.15; color: var(--ink); font-weight: 800; max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pn-brand small { display: block; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-ink); font-weight: 700; }
  .pn-links { display: flex; gap: 4px; margin-left: auto; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .pn-links::-webkit-scrollbar { display: none; }
  .pn-link { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .86rem; color: var(--ink-2); white-space: nowrap; transition: background-color .15s ease, color .15s ease; }
  .pn-link:hover { background: var(--surface-2); color: var(--primary-dark); }
  .pn-link.is-active { background: linear-gradient(135deg, #2bc23c 0%, var(--primary-darker) 100%); color: #fff; box-shadow: 0 8px 16px -10px rgba(30,175,47,.9); }
  .pn-tools { display: flex; gap: 6px; flex: none; align-items: center; }
  .pn-ic { width: 38px; height: 38px; border-radius: 12px; border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--ink-2); display: inline-grid; place-items: center; cursor: pointer; text-decoration: none; font-size: .9rem; }
  .pn-ic:hover { border-color: var(--primary-color); color: var(--primary-dark); }
  .pn-login { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink-2); font-weight: 600; font-size: .84rem; text-decoration: none; }
  .pn-login:hover { border-color: var(--primary-color); color: var(--primary-dark); }
  .pn-install[hidden] { display: none !important; }
  .pn-sun { display: none; }
  html.dark-mode .pn-sun { display: inline; }
  html.dark-mode .pn-moon { display: none; }
  @media (max-width: 820px) {
    .pn-in { flex-wrap: wrap; row-gap: 8px; padding: 10px 12px; }
    .pn-brand b { max-width: 150px; }
    .pn-tools { margin-left: auto; }
    .pn-links { order: 3; width: 100%; margin-left: 0; }
    .pn-login span { display: none; }
    .pn-login { width: 38px; padding: 0; justify-content: center; }
  }
  @media print { .pn-bar { display: none !important; } }
</style>
<div class="pn-bar rm-noprint mj-noprint">
  <div class="pn-in">
    <a class="pn-brand" href="/jadwal-ramadan" aria-label="<%= settings.masjid_nama %>">
      <img src="/images/logo-dkm.png" alt="" width="38" height="38">
      <span><b><%= settings.masjid_nama %></b><small><%= settings.masjid_tipe === 'masjid' ? 'Masjid' : 'Musholla' %></small></span>
    </a>
    <nav class="pn-links" aria-label="Halaman jamaah">
      <% pnLinks.forEach(function (l) { %>
        <a class="pn-link <%= active === l.key ? 'is-active' : '' %>" href="<%= l.href %>" <%- active === l.key ? 'aria-current="page"' : '' %>><i class="fas <%= l.icon %>"></i><%= l.label %></a>
      <% }) %>
    </nav>
    <div class="pn-tools">
      <button type="button" class="pn-ic pn-install" data-pwa-install hidden title="Pasang aplikasi di HP" aria-label="Pasang aplikasi"><i class="fas fa-download"></i></button>
      <button type="button" class="pn-ic" onclick="toggleTheme()" title="Mode terang / gelap" aria-label="Ganti tema"><i class="fas fa-moon pn-moon"></i><i class="fas fa-sun pn-sun"></i></button>
    </div>
  </div>
</div>
