<%- include('../layouts/header', { title: title, bodyClass: 'bg-gray-50 min-h-screen', currentPage: 'distribusi' }) %>

<%
  const d = distribusi;
  const isUang = d.jenis_zakat === 'uang';
  const jumlah = Number(d.jumlah) || 0;
  const amountText = isUang
    ? 'Rp ' + Math.floor(jumlah).toLocaleString('id-ID')
    : jumlah.toLocaleString('id-ID', { maximumFractionDigits: 2 }) + ' kg';
  const code = '#' + String(d.id).padStart(6, '0');
  const fmtDate = (v) => v ? new Date(v).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';
  const fmtTime = (v) => v ? new Date(v).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
  const fmtAmount = (jenis, value) => jenis === 'uang'
    ? 'Rp ' + Math.floor(Number(value) || 0).toLocaleString('id-ID')
    : (Number(value) || 0).toLocaleString('id-ID', { maximumFractionDigits: 2 }) + ' kg';

  const statusMeta = {
    pending: { label: 'Menunggu', icon: 'fa-hourglass-half', tone: 'warn' },
    disalurkan: { label: 'Disalurkan', icon: 'fa-truck', tone: 'info' },
    diterima: { label: 'Diterima', icon: 'fa-circle-check', tone: 'ok' },
    batal: { label: 'Dibatalkan', icon: 'fa-ban', tone: 'err' }
  };
  const st = statusMeta[d.status] || statusMeta.pending;

  const flow = d.status === 'batal'
    ? [
        { key: 'pending', label: 'Dibuat', icon: 'fa-file-circle-plus' },
        { key: 'batal', label: 'Dibatalkan', icon: 'fa-ban' }
      ]
    : [
        { key: 'pending', label: 'Dibuat', icon: 'fa-file-circle-plus' },
        { key: 'disalurkan', label: 'Disalurkan', icon: 'fa-truck' },
        { key: 'diterima', label: 'Diterima', icon: 'fa-circle-check' }
      ];
  const order = { pending: 0, disalurkan: 1, diterima: 2, batal: 1 };
  const activeIdx = order[d.status] !== undefined ? order[d.status] : 0;

  const kategori = String(d.mustahik_kategori || '-').replace(/_/g, ' ');
  const canEdit = d.status === 'pending' || d.status === 'disalurkan';
  const canDelete = d.status === 'pending' || d.status === 'batal';
  const backPath = '/distribusi/detail/' + d.id;
%>

<style>
  .dd-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--card-radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    min-width: 0;
  }

  .dd-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
  }

  .dd-card-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-darker) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 8px 14px -6px rgba(30, 175, 47, 0.5);
    color: #fff;
    font-size: 14px;
  }

  .dd-card-title { color: var(--ink); font-size: 0.95rem; font-weight: 700; }
  .dd-card-sub { margin-top: 1px; color: var(--muted); font-size: 0.76rem; }
  .dd-card-body { flex: 1; display: flex; flex-direction: column; padding: 18px 20px 20px; }

  /* ---------- Ringkasan + tombol ---------- */
  .dd-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
    padding: 22px 24px 20px;
    background:
      radial-gradient(460px 170px at 100% -30%, rgba(30, 175, 47, 0.14), transparent 70%),
      linear-gradient(135deg, rgba(201, 162, 75, 0.08), transparent 60%),
      var(--surface);
  }

  .dd-hero-label {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dd-hero-amount {
    margin-top: 6px;
    color: var(--ink);
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .dd-hero-chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .dd-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .dd-chip.tone-warn { background: rgba(245, 158, 11, 0.14); border-color: rgba(245, 158, 11, 0.4); color: #b45309; }
  .dd-chip.tone-info { background: rgba(59, 130, 246, 0.12); border-color: rgba(59, 130, 246, 0.38); color: #1d4ed8; }
  .dd-chip.tone-ok { background: rgba(30, 175, 47, 0.14); border-color: rgba(30, 175, 47, 0.4); color: var(--primary-darker); }
  .dd-chip.tone-err { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.38); color: #b91c1c; }
  html.dark-mode .dd-chip.tone-warn { color: #fcd34d; }
  html.dark-mode .dd-chip.tone-info { color: #93c5fd; }
  html.dark-mode .dd-chip.tone-ok { color: #86efac; }
  html.dark-mode .dd-chip.tone-err { color: #fca5a5; }

  .dd-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .dd-meta-item { padding: 15px 24px; border-right: 1px solid var(--line); min-width: 0; }
  .dd-meta-item:last-child { border-right: 0; }

  .dd-meta-label {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dd-meta-value { margin-top: 4px; color: var(--ink); font-size: 0.9rem; font-weight: 600; word-break: break-word; }
  .dd-meta-value small { display: block; margin-top: 1px; color: var(--muted); font-size: 0.74rem; font-weight: 500; }

  .dd-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }

  .dd-toolbar form { display: contents; }
  .dd-toolbar .dd-spacer { flex: 1; }

  .dd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 18px;
    border: 1px solid transparent;
    border-radius: 12px;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .dd-btn-primary {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-darker) 100%);
    box-shadow: 0 12px 22px -12px rgba(30, 175, 47, 0.75);
    color: #fff;
  }
  .dd-btn-primary:hover { filter: brightness(1.07); }

  .dd-btn-outline { border-color: var(--line-strong); background: var(--surface); color: var(--ink-2); }
  .dd-btn-outline i { color: var(--primary-dark); }
  .dd-btn-outline:hover { border-color: rgba(30, 175, 47, 0.55); background: rgba(30, 175, 47, 0.07); color: var(--ink); }

  .dd-btn-warn { border-color: rgba(245, 158, 11, 0.5); background: var(--surface); color: #b45309; }
  .dd-btn-warn:hover { background: rgba(245, 158, 11, 0.12); }
  html.dark-mode .dd-btn-warn { color: #fcd34d; }

  .dd-btn-danger { border-color: rgba(239, 68, 68, 0.45); background: var(--surface); color: #dc2626; }
  .dd-btn-danger:hover { background: rgba(239, 68, 68, 0.1); }
  html.dark-mode .dd-btn-danger { color: #fca5a5; }

  /* ---------- Alur status ---------- */
  .dd-steps {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    padding: 18px 12px 16px;
  }

  .dd-step { position: relative; text-align: center; padding: 0 6px; }

  .dd-step::before {
    content: "";
    position: absolute;
    top: 18px;
    left: -50%;
    right: 50%;
    height: 3px;
    border-radius: 3px;
    background: var(--line-strong);
  }

  .dd-step:first-child::before { display: none; }
  .dd-step.is-done::before,
  .dd-step.is-current::before { background: linear-gradient(90deg, var(--primary-color), var(--primary-dark)); }
  .dd-step.is-err::before { background: linear-gradient(90deg, var(--primary-color), #dc2626); }

  .dd-step-dot {
    position: relative;
    z-index: 1;
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    display: grid;
    place-items: center;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--faint);
    font-size: 13px;
  }

  .dd-step.is-done .dd-step-dot { border-color: transparent; background: var(--primary-color); color: #fff; }

  .dd-step.is-current .dd-step-dot {
    border-color: transparent;
    background: linear-gradient(135deg, #2bc23c 0%, var(--primary-darker) 100%);
    box-shadow: 0 0 0 5px rgba(30, 175, 47, 0.18);
    color: #fff;
  }

  .dd-step.is-current.is-err .dd-step-dot {
    background: linear-gradient(135deg, #f26a6a 0%, #dc2626 100%);
    box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.18);
  }

  .dd-step-label { color: var(--muted); font-size: 0.82rem; font-weight: 600; }
  .dd-step.is-done .dd-step-label,
  .dd-step.is-current .dd-step-label { color: var(--ink); }
  .dd-step-date { margin-top: 2px; color: var(--faint); font-size: 0.72rem; line-height: 1.35; }
  .dd-step.is-current .dd-step-date,
  .dd-step.is-done .dd-step-date { color: var(--muted); }

  /* ---------- Dua kartu sejajar ---------- */
  .dd-two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .dd-person { display: flex; align-items: center; gap: 14px; }

  .dd-avatar {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #2bc23c 0%, var(--forest) 100%);
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px rgba(201, 162, 75, 0.7);
    color: #fff;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .dd-person-name { color: var(--ink); font-size: 1.1rem; font-weight: 700; line-height: 1.25; word-break: break-word; }
  .dd-person-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
  .dd-person-meta .category-badge { text-transform: capitalize; }

  .dd-person-actions { margin-top: auto; padding-top: 18px; }
  .dd-person-actions .dd-btn { width: 100%; }

  .dd-proof {
    position: relative;
    display: block;
    flex: 1;
    width: 100%;
    min-height: 190px;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: var(--surface-2);
    overflow: hidden;
    cursor: zoom-in;
  }

  .dd-proof img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .dd-proof-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 999px;
    background: rgba(8, 20, 12, 0.65);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .dd-empty {
    flex: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    min-height: 150px;
    padding: 20px 16px;
    border: 1px dashed var(--line-strong);
    border-radius: 16px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.86rem;
    text-align: center;
  }

  .dd-empty i { color: var(--faint); font-size: 26px; }
  .dd-card .dd-history + .dd-empty, .dd-card-body > .dd-empty:only-child { min-height: 110px; }
  .dd-empty strong { color: var(--ink-2); }

  /* ---------- Riwayat ---------- */
  .dd-history { display: grid; gap: 8px; }

  .dd-history-item {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-2);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .dd-history-item:hover { border-color: rgba(30, 175, 47, 0.45); background: rgba(30, 175, 47, 0.06); }
  .dd-history-item > i { color: var(--faint); font-size: 12px; }
  .dd-history-date { color: var(--ink); font-size: 0.88rem; font-weight: 600; }
  .dd-history-amount { color: var(--ink); font-size: 0.9rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .dd-history-kind { color: var(--muted); font-size: 0.74rem; }

  .dd-mini { padding: 3px 11px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; white-space: nowrap; }
  .dd-mini.tone-warn { background: rgba(245, 158, 11, 0.16); color: #b45309; }
  .dd-mini.tone-info { background: rgba(59, 130, 246, 0.14); color: #1d4ed8; }
  .dd-mini.tone-ok { background: rgba(30, 175, 47, 0.16); color: var(--primary-darker); }
  .dd-mini.tone-err { background: rgba(239, 68, 68, 0.14); color: #b91c1c; }
  html.dark-mode .dd-mini.tone-warn { color: #fcd34d; }
  html.dark-mode .dd-mini.tone-info { color: #93c5fd; }
  html.dark-mode .dd-mini.tone-ok { color: #86efac; }
  html.dark-mode .dd-mini.tone-err { color: #fca5a5; }

  @media (max-width: 900px) {
    .dd-two { grid-template-columns: 1fr; }
    .dd-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dd-meta-item:nth-child(2) { border-right: 0; }
    .dd-meta-item:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 640px) {
    .dd-top { padding: 18px 16px 16px; }
    .dd-hero-amount { font-size: 1.8rem; }
    .dd-meta-item { padding: 13px 16px; }

    .dd-toolbar { display: grid; grid-template-columns: 1fr 1fr; padding: 14px 16px; }
    .dd-toolbar .dd-spacer { display: none; }
    .dd-toolbar .dd-btn { width: 100%; padding: 0 10px; }
    .dd-toolbar .dd-btn-primary { grid-column: 1 / -1; }

    .dd-history-item { grid-template-columns: minmax(0, 1fr) auto; row-gap: 4px; }
    .dd-history-item > i { display: none; }
    .dd-history-item .dd-mini { grid-row: 1; grid-column: 2; }
    .dd-step-date { font-size: 0.66rem; }
  }
</style>

<div class="page-wrapper">
  <div class="page-header">
    <div class="header-content-wrapper">
      <div class="header-left-section">
        <div class="header-icon-box"><i class="fas fa-share-nodes"></i></div>
        <div>
          <h1 class="header-title-text">Detail Distribusi</h1>
          <p class="header-subtitle-text"><%= code %> · <%= d.mustahik_nama || 'Mustahik' %></p>
        </div>
      </div>
      <div class="header-actions">
        <a href="/distribusi" class="btn-action btn-action-primary"><i class="fas fa-arrow-left"></i>Kembali</a>
      </div>
    </div>
  </div>

  <!-- Ringkasan + tombol aksi -->
  <section class="dd-card">
    <div class="dd-top">
      <div>
        <div class="dd-hero-label">Jumlah Distribusi</div>
        <div class="dd-hero-amount"><%= amountText %></div>
      </div>
      <div class="dd-hero-chips">
        <span class="dd-chip"><i class="fas <%= isUang ? 'fa-money-bill-wave' : 'fa-wheat-awn' %>"></i><%= isUang ? 'Zakat Uang' : 'Zakat Beras' %></span>
        <span class="dd-chip tone-<%= st.tone %>"><i class="fas <%= st.icon %>"></i><%= st.label %></span>
      </div>
    </div>

    <div class="dd-meta">
      <div class="dd-meta-item">
        <div class="dd-meta-label">Kode</div>
        <div class="dd-meta-value"><%= code %></div>
      </div>
      <div class="dd-meta-item">
        <div class="dd-meta-label">Petugas (PIC)</div>
        <div class="dd-meta-value"><%= d.user_nama || '-' %></div>
      </div>
      <div class="dd-meta-item">
        <div class="dd-meta-label">Dibuat</div>
        <div class="dd-meta-value"><%= fmtDate(d.created_at) %><small><%= fmtTime(d.created_at) %> WIB</small></div>
      </div>
      <div class="dd-meta-item">
        <div class="dd-meta-label">Diperbarui</div>
        <div class="dd-meta-value"><%= fmtDate(d.updated_at) %><small><%= fmtTime(d.updated_at) %> WIB</small></div>
      </div>
    </div>

    <div class="dd-toolbar">
      <% if (d.status === 'pending') { %>
        <form method="POST" action="/distribusi/status/<%= d.id %>?_method=PUT" data-confirm-title="Tandai disalurkan?" data-confirm-text="Status berubah menjadi Disalurkan." data-confirm-button="Ya, Tandai" data-confirm-color="#1EAF2F">
          <input type="hidden" name="status" value="disalurkan" />
          <input type="hidden" name="return_to" value="<%= backPath %>" />
          <button type="submit" class="dd-btn dd-btn-primary"><i class="fas fa-truck"></i>Tandai Disalurkan</button>
        </form>
      <% } else if (d.status === 'disalurkan') { %>
        <form method="POST" action="/distribusi/status/<%= d.id %>?_method=PUT" data-confirm-title="Tandai diterima?" data-confirm-text="Penerima sudah menerima zakat ini." data-confirm-button="Ya, Sudah Diterima" data-confirm-color="#1EAF2F">
          <input type="hidden" name="status" value="diterima" />
          <input type="hidden" name="return_to" value="<%= backPath %>" />
          <button type="submit" class="dd-btn dd-btn-primary"><i class="fas fa-circle-check"></i>Tandai Diterima</button>
        </form>
      <% } %>

      <% if (canEdit) { %>
        <a href="/distribusi?edit=<%= d.id %>" class="dd-btn dd-btn-outline"><i class="fas fa-pen-to-square"></i>Edit</a>
      <% } %>
      <a href="/distribusi/create?mustahik_id=<%= d.mustahik_id %>" class="dd-btn dd-btn-outline"><i class="fas fa-plus"></i>Distribusi Lagi</a>

      <span class="dd-spacer"></span>

      <% if (d.status === 'pending') { %>
        <form method="POST" action="/distribusi/status/<%= d.id %>?_method=PUT" data-confirm-title="Batalkan distribusi?" data-confirm-text="Distribusi ini akan ditandai Dibatalkan." data-confirm-button="Ya, Batalkan" data-confirm-color="#f59e0b">
          <input type="hidden" name="status" value="batal" />
          <input type="hidden" name="return_to" value="<%= backPath %>" />
          <button type="submit" class="dd-btn dd-btn-warn"><i class="fas fa-ban"></i>Batalkan</button>
        </form>
      <% } %>
      <% if (canDelete) { %>
        <form method="POST" action="/distribusi/delete/<%= d.id %>?_method=DELETE" data-confirm-title="Hapus distribusi?" data-confirm-text="Data ini akan dihapus permanen dan tidak bisa dikembalikan." data-confirm-button="Ya, Hapus" data-confirm-color="#ef4444">
          <button type="submit" class="dd-btn dd-btn-danger"><i class="fas fa-trash"></i>Hapus</button>
        </form>
      <% } %>
    </div>
  </section>

  <!-- Alur status -->
  <section class="dd-card">
    <div class="dd-steps" aria-label="Alur status distribusi">
      <% flow.forEach(function (step, i) {
           const state = i < activeIdx ? 'is-done' : (i === activeIdx ? 'is-current' : '');
           const err = step.key === 'batal' ? ' is-err' : '';
           let date = 'Menunggu';
           if (i === 0) date = fmtDate(d.created_at) + ' · ' + fmtTime(d.created_at);
           else if (i === activeIdx) date = fmtDate(d.updated_at) + ' · ' + fmtTime(d.updated_at);
           else if (i < activeIdx) date = 'Selesai';
      %>
        <div class="dd-step <%= state %><%= err %>">
          <div class="dd-step-dot"><i class="fas <%= i < activeIdx && i !== 0 ? 'fa-check' : step.icon %>"></i></div>
          <div class="dd-step-label"><%= step.label %></div>
          <div class="dd-step-date"><%= date %></div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Penerima + bukti (tinggi sama) -->
  <div class="dd-two">
    <section class="dd-card">
      <div class="dd-card-head">
        <span class="dd-card-icon"><i class="fas fa-user-group"></i></span>
        <div>
          <div class="dd-card-title">Penerima</div>
          <div class="dd-card-sub">Mustahik penerima zakat</div>
        </div>
      </div>
      <div class="dd-card-body">
        <div class="dd-person">
          <div class="dd-avatar"><%= (d.mustahik_nama || '?').charAt(0).toUpperCase() %></div>
          <div style="min-width: 0">
            <div class="dd-person-name"><%= d.mustahik_nama || '-' %></div>
            <div class="dd-person-meta">
              <span class="category-badge category-<%= d.mustahik_kategori %>"><i class="fas fa-tag"></i><%= kategori %></span>
              <span class="category-badge" style="background: var(--surface-2); color: var(--ink-2); border: 1px solid var(--line)"><i class="fas fa-house"></i><%= d.rt_nama || 'Tanpa RT' %></span>
            </div>
          </div>
        </div>
        <div class="dd-person-actions">
          <a href="/mustahik/detail/<%= d.mustahik_id %>" class="dd-btn dd-btn-outline"><i class="fas fa-id-card"></i>Lihat Profil Mustahik</a>
        </div>
      </div>
    </section>

    <section class="dd-card">
      <div class="dd-card-head">
        <span class="dd-card-icon"><i class="fas fa-image"></i></span>
        <div>
          <div class="dd-card-title">Bukti Distribusi</div>
          <div class="dd-card-sub">Foto penyaluran zakat kepada penerima</div>
        </div>
      </div>
      <div class="dd-card-body">
        <% if (d.bukti_foto) { %>
          <button type="button" class="dd-proof" data-modal-open="bukti-modal" data-src="<%= d.bukti_foto %>" aria-label="Perbesar bukti distribusi">
            <img src="<%= d.bukti_foto %>" alt="Bukti distribusi <%= code %>" loading="lazy" />
            <span class="dd-proof-hint"><i class="fas fa-magnifying-glass-plus"></i>Perbesar</span>
          </button>
        <% } else { %>
          <div class="dd-empty">
            <i class="fas fa-image"></i>
            <strong>Belum ada bukti foto</strong>
            <span>Tambahkan foto lewat tombol Edit.</span>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <!-- Riwayat -->
  <section class="dd-card">
    <div class="dd-card-head">
      <span class="dd-card-icon"><i class="fas fa-clock-rotate-left"></i></span>
      <div>
        <div class="dd-card-title">Riwayat Penerima Ini</div>
        <div class="dd-card-sub">Distribusi lain untuk mustahik yang sama</div>
      </div>
    </div>
    <div class="dd-card-body">
      <% if (riwayat && riwayat.length) { %>
        <div class="dd-history">
          <% riwayat.forEach(function (h) { const hs = statusMeta[h.status] || statusMeta.pending; %>
            <a href="/distribusi/detail/<%= h.id %>" class="dd-history-item">
              <div>
                <div class="dd-history-date"><%= fmtDate(h.created_at) %></div>
                <div class="dd-history-kind"><%= h.jenis_zakat === 'uang' ? 'Zakat uang' : 'Zakat beras' %></div>
              </div>
              <div class="dd-history-amount"><%= fmtAmount(h.jenis_zakat, h.jumlah) %></div>
              <span class="dd-mini tone-<%= hs.tone %>"><%= hs.label %></span>
              <i class="fas fa-chevron-right"></i>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="dd-empty">
          <i class="fas fa-inbox"></i>
          <span>Belum ada distribusi lain untuk penerima ini.</span>
        </div>
      <% } %>
    </div>
  </section>
</div>

<script>
  // Konfirmasi sebelum aksi yang mengubah data
  document.querySelectorAll("form[data-confirm-title]").forEach(function (form) {
    form.addEventListener("submit", function (event) {
      if (form.dataset.confirmed === "1") {
        return;
      }
      event.preventDefault();
      Swal.fire({
        title: form.dataset.confirmTitle,
        text: form.dataset.confirmText,
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: form.dataset.confirmColor || "#1EAF2F",
        cancelButtonColor: "#6b7280",
        confirmButtonText: form.dataset.confirmButton || "Ya",
        cancelButtonText: "Batal",
        reverseButtons: true,
      }).then(function (result) {
        if (result.isConfirmed) {
          form.dataset.confirmed = "1";
          form.submit();
        }
      });
    });
  });
</script>

<%- include('partials/bukti-modal') %>

<%- include('../layouts/footer') %>
