<%# Modal tambah/ubah RW. Dibuka lewat <a data-modal-open="rw-modal" data-mode="create|edit" data-id=""> %>
<div class="am" id="rw-modal" role="dialog" aria-modal="true" aria-labelledby="rw-modal-title" aria-hidden="true">
  <div class="am-backdrop" data-modal-close></div>

  <div class="am-panel" data-loading="0">
    <header class="am-head">
      <span class="am-head-icon"><i class="fas fa-building" id="rw-modal-icon"></i></span>
      <div class="am-head-text">
        <h2 class="am-title" id="rw-modal-title">Tambah RW</h2>
        <p class="am-sub" id="rw-modal-sub">Tambahkan data Rukun Warga baru ke sistem</p>
      </div>
      <button type="button" class="am-close" data-modal-close aria-label="Tutup"><i class="fas fa-xmark"></i></button>
    </header>

    <form class="am-form" id="rw-modal-form" method="POST" action="/rw/create" novalidate>
      <input type="hidden" name="return_to" id="rw-modal-return">

      <div class="am-body">
        <div class="am-error" data-am-error role="alert"><i class="fas fa-circle-exclamation"></i><span></span></div>

        <div class="am-row">
          <div class="am-field">
            <label for="rw-modal-nomor">Nomor RW <span class="req">*</span></label>
            <div class="am-control" data-control>
              <i class="fas fa-hashtag lead"></i>
              <input type="text" id="rw-modal-nomor" name="nomor_rw" required maxlength="10" placeholder="Contoh: RW 01" autocomplete="off">
            </div>
            <div class="am-hint">Ketik angka saja, otomatis jadi "RW 01".</div>
          </div>

          <div class="am-field">
            <label for="rw-modal-ketua">Nama Ketua RW <span class="req">*</span></label>
            <div class="am-control" data-control>
              <i class="fas fa-user lead"></i>
              <input type="text" id="rw-modal-ketua" name="ketua_rw" required maxlength="100" placeholder="Nama lengkap ketua RW" autocomplete="off">
            </div>
            <div class="am-hint">Dipakai untuk identifikasi di laporan.</div>
          </div>
        </div>

        <div class="am-field">
          <label for="rw-modal-ket">Keterangan <span class="opt">(opsional)</span></label>
          <div class="am-control is-area">
            <i class="fas fa-note-sticky lead"></i>
            <textarea id="rw-modal-ket" name="keterangan" rows="3" maxlength="100" placeholder="Catatan tambahan, mis. wilayah cakupan RW"></textarea>
          </div>
        </div>

        <div class="am-preview" aria-hidden="true">
          <span class="am-preview-label">Pratinjau</span>
          <span class="am-preview-badge" id="rw-modal-pv-rw">RW --</span>
          <div style="min-width: 0">
            <div class="am-preview-name" id="rw-modal-pv-ketua">Nama ketua RW</div>
            <div class="am-preview-meta">Rukun Warga</div>
          </div>
        </div>
      </div>

      <footer class="am-foot">
        <button type="button" class="am-btn am-btn-ghost" data-modal-close>Batal</button>
        <button type="submit" class="am-btn am-btn-primary" id="rw-modal-submit"><i class="fas fa-floppy-disk"></i><span>Simpan RW</span></button>
      </footer>
    </form>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById("rw-modal");
    var panel = modal.querySelector(".am-panel");
    var form = document.getElementById("rw-modal-form");
    var nomor = document.getElementById("rw-modal-nomor");
    var ketua = document.getElementById("rw-modal-ketua");
    var ket = document.getElementById("rw-modal-ket");
    var errorBox = form.querySelector("[data-am-error]");

    function cleanReturnPath() {
      var url = new URL(window.location.href);
      ["new", "edit"].forEach(function (k) { url.searchParams.delete(k); });
      return url.pathname + url.search;
    }

    function showError(message) {
      errorBox.querySelector("span").textContent = message;
      errorBox.classList.add("is-visible");
    }

    function clearErrors() {
      errorBox.classList.remove("is-visible");
      [].forEach.call(form.querySelectorAll("[data-control]"), function (c) { c.classList.remove("is-invalid"); });
    }

    function refreshPreview() {
      document.getElementById("rw-modal-pv-rw").textContent = formatNomor(nomor.value) || "RW --";
      document.getElementById("rw-modal-pv-ketua").textContent = ketua.value.trim() || "Nama ketua RW";
    }

    function setMode(mode, id) {
      var edit = mode === "edit";
      document.getElementById("rw-modal-title").textContent = edit ? "Edit RW" : "Tambah RW";
      document.getElementById("rw-modal-sub").textContent = edit ? "Perbarui data RW yang sudah terdaftar" : "Tambahkan data Rukun Warga baru ke sistem";
      document.getElementById("rw-modal-icon").className = edit ? "fas fa-pen-to-square" : "fas fa-building";
      document.querySelector("#rw-modal-submit span").textContent = edit ? "Simpan Perubahan" : "Simpan RW";
      form.setAttribute("action", edit ? "/rw/" + id + "/edit" : "/rw/create");
    }

    function openWith(mode, id) {
      setMode(mode, id);
      form.reset();
      clearErrors();
      document.getElementById("rw-modal-return").value = cleanReturnPath();
      refreshPreview();

      if (mode !== "edit") {
        window.AppModal.focusFirst(modal);
        return;
      }

      panel.setAttribute("data-loading", "1");
      fetch("/rw/form-data?id=" + encodeURIComponent(id), { credentials: "same-origin", headers: { Accept: "application/json" } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok) { throw new Error(data.message || "Gagal memuat data"); }
          nomor.value = data.rw.nomor_rw || "";
          ketua.value = data.rw.ketua_rw || "";
          ket.value = data.rw.keterangan || "";
          refreshPreview();
        })
        .catch(function (error) { showError(error.message || "Gagal memuat data"); })
        .then(function () {
          panel.setAttribute("data-loading", "0");
          window.AppModal.focusFirst(modal);
        });
    }

    modal.addEventListener("am:open", function (event) {
      var t = event.detail.trigger;
      var edit = t && t.dataset && t.dataset.mode === "edit";
      openWith(edit ? "edit" : "create", t && t.dataset ? t.dataset.id : null);
    });

    // "7", "rt 7" atau "RT7" -> "RW 07"; dirapikan saat kolom ditinggalkan agar mengetik "11" tidak jadi "RW 011"
    function formatNomor(raw) {
      var v = String(raw || "").trim().toUpperCase();
      var m = v.match(/^(?:RW\s*)?(\d+)$/);
      if (m) {
        var n = parseInt(m[1], 10);
        return "RW " + (n < 10 ? "0" + n : n);
      }
      return v;
    }

    nomor.addEventListener("input", refreshPreview);
    nomor.addEventListener("blur", function () {
      nomor.value = formatNomor(nomor.value);
      refreshPreview();
    });
    ketua.addEventListener("input", refreshPreview);

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      clearErrors();
      nomor.value = formatNomor(nomor.value);

      var missing = [nomor, ketua].filter(function (el) { return !el.value.trim(); });
      if (missing.length) {
        missing.forEach(function (el) { el.closest("[data-control]").classList.add("is-invalid"); });
        showError("Nomor RW dan nama ketua RW harus diisi.");
        missing[0].focus();
        return;
      }

      window.AppModal.submit(form);
    });

    // Tautan lama: /rw?new=1  atau  /rw?edit=ID
    document.addEventListener("DOMContentLoaded", function () {
      var params = new URLSearchParams(window.location.search);
      var trigger = null;
      if (params.has("new")) {
        trigger = { dataset: { mode: "create" } };
      } else if (params.get("edit")) {
        trigger = { dataset: { mode: "edit", id: params.get("edit") } };
      }
      if (trigger) {
        window.AppModal.open("rw-modal", trigger);
        window.history.replaceState(null, "", cleanReturnPath());
      }
    });
  })();
</script>
