    <% } %>

    <script>
      const THEME_STORAGE_KEY = "app-theme";

      function getStoredTheme() {
        try {
          const saved = localStorage.getItem(THEME_STORAGE_KEY);
          if (saved === "dark" || saved === "light") {
            return saved;
          }
        } catch (error) {
          return null;
        }
        return null;
      }

      function getPreferredTheme() {
        const stored = getStoredTheme();
        if (stored) {
          return stored;
        }

        return window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }

      function updateThemeToggleUI(theme) {
        const toggle = document.getElementById("themeToggleAdmin");
        if (toggle) {
          toggle.setAttribute("aria-checked", theme === "dark" ? "true" : "false");
        }
      }

      function applyTheme(theme) {
        const isDark = theme === "dark";
        document.documentElement.classList.toggle("dark-mode", isDark);
        document.body.classList.toggle("dark-mode", isDark);
        updateThemeToggleUI(theme);
      }

      function saveTheme(theme) {
        try {
          localStorage.setItem(THEME_STORAGE_KEY, theme);
        } catch (error) {
          // Ignore storage failures.
        }
      }

      function toggleTheme() {
        const nextTheme = document.documentElement.classList.contains("dark-mode")
          ? "light"
          : "dark";
        applyTheme(nextTheme);
        saveTheme(nextTheme);
      }

      window.toggleTheme = toggleTheme;

      // Konfirmasi sebelum keluar (tombol di sidebar maupun menu cepat Ctrl+K)
      function confirmLogout() {
        const form = document.getElementById("logoutForm");
        if (!form) { return; }
        if (!window.Swal) {
          if (window.confirm("Keluar dari aplikasi?")) { form.submit(); }
          return;
        }
        Swal.fire({
          title: "Keluar dari aplikasi?",
          text: "Anda perlu login lagi untuk masuk kembali.",
          icon: "question",
          showCancelButton: true,
          confirmButtonText: "Ya, keluar",
          cancelButtonText: "Batal",
          reverseButtons: true,
          focusCancel: true,
          confirmButtonColor: "#14912a"
        }).then(function (result) {
          if (result.isConfirmed) { form.submit(); }
        });
      }
      window.confirmLogout = confirmLogout;
      document.addEventListener("submit", function (event) {
        if (event.target && event.target.id === "logoutForm") {
          event.preventDefault();
          confirmLogout();
        }
      });

      function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebarOverlay");
        const isMobile = window.innerWidth <= 768;

        if (sidebar && overlay) {
          sidebar.classList.toggle("show");
          overlay.classList.toggle("show");

          if (isMobile) {
            const willOpen = sidebar.classList.contains("show");
            document.body.classList.toggle("sidebar-open", willOpen);
          }
        }
      }

      window.toggleSidebar = toggleSidebar;

      (function () {
        const root = document.documentElement;
        const isDesktop = function () { return window.innerWidth > 768; };
        const isMac = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent || "");

        /* ---------- Tooltip ---------- */
        const tip = document.getElementById("appTooltip");
        let tipTarget = null;

        function tipText(el) {
          if (el.hasAttribute("data-tip-collapsed")) {
            return root.classList.contains("sidebar-collapsed") && isDesktop()
              ? el.getAttribute("data-tip-collapsed")
              : null;
          }
          return el.getAttribute("data-tip");
        }

        function hideTip() {
          tipTarget = null;
          if (tip) {
            tip.classList.remove("show");
          }
        }

        function showTip(el) {
          const text = tipText(el);
          if (!tip || !text) {
            hideTip();
            return;
          }

          tipTarget = el;
          tip.textContent = text;

          const r = el.getBoundingClientRect();
          const tw = tip.offsetWidth;
          const th = tip.offsetHeight;
          const pos = el.getAttribute("data-tip-pos") || "bottom";
          let left;
          let top;

          if (pos === "right") {
            left = r.right + 12;
            top = r.top + r.height / 2 - th / 2;
          } else if (pos === "top") {
            left = r.left + r.width / 2 - tw / 2;
            top = r.top - th - 10;
          } else {
            left = r.left + r.width / 2 - tw / 2;
            top = r.bottom + 10;
          }

          tip.style.left = Math.max(8, Math.min(left, window.innerWidth - tw - 8)) + "px";
          tip.style.top = Math.max(8, Math.min(top, window.innerHeight - th - 8)) + "px";
          tip.classList.add("show");
        }

        function tipHost(node) {
          return node && node.closest ? node.closest("[data-tip],[data-tip-collapsed]") : null;
        }

        document.addEventListener("mouseover", function (e) {
          const el = tipHost(e.target);
          if (!el) {
            if (tipTarget) {
              hideTip();
            }
            return;
          }
          if (el !== tipTarget) {
            showTip(el);
          }
        });

        document.addEventListener("focusin", function (e) {
          const el = tipHost(e.target);
          if (el && el !== tipTarget) {
            showTip(el);
          }
        });

        document.addEventListener("focusout", hideTip);
        document.addEventListener("mousedown", hideTip);
        window.addEventListener("scroll", hideTip, true);
        window.addEventListener("resize", hideTip);

        /* ---------- Sidebar collapse ---------- */
        const collapseBtn = document.getElementById("sidebarCollapseBtn");

        function syncCollapseUi() {
          if (!collapseBtn) {
            return;
          }
          const collapsed = root.classList.contains("sidebar-collapsed");
          const label = collapsed ? "Tampilkan sidebar" : "Sembunyikan sidebar";
          collapseBtn.setAttribute("aria-pressed", collapsed ? "true" : "false");
          collapseBtn.setAttribute("aria-label", label);
          collapseBtn.setAttribute("data-tip", label);

          const icon = document.getElementById("sidebarCollapseIcon");
          if (icon) {
            icon.className = collapsed ? "fas fa-chevron-right" : "fas fa-chevron-left";
          }
        }

        function setCollapsed(collapsed) {
          root.classList.toggle("sidebar-collapsed", collapsed);
          try {
            localStorage.setItem("sidebar-collapsed", collapsed ? "1" : "0");
          } catch (error) {
            // Ignore storage failures.
          }
          syncCollapseUi();
          hideTip();
        }

        function toggleCollapse() {
          setCollapsed(!root.classList.contains("sidebar-collapsed"));
        }

        window.toggleSidebarCollapse = toggleCollapse;
        syncCollapseUi();

        if (collapseBtn) {
          collapseBtn.addEventListener("click", function () {
            toggleCollapse();
            // tooltip baru tampil lagi setelah animasi selesai, jika kursor masih di atas tombol
            setTimeout(function () {
              if (collapseBtn.matches(":hover")) {
                showTip(collapseBtn);
              }
            }, 320);
          });
        }

        /* ---------- Command palette (Ctrl/Cmd + K) ---------- */
        const cmdk = document.getElementById("cmdk");
        const input = document.getElementById("cmdkInput");
        const listEl = document.getElementById("cmdkList");
        const trigger = document.getElementById("searchTrigger");
        const kbd = document.getElementById("searchKbd");

        if (kbd) {
          kbd.textContent = isMac ? "⌘ K" : "Ctrl K";
        }
        if (trigger) {
          trigger.setAttribute("data-tip", "Cari menu (" + (isMac ? "⌘K" : "Ctrl+K") + ")");
        }

        let all = [];
        let shown = [];
        let active = 0;
        let lastFocus = null;

        function esc(text) {
          return String(text).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }

        function highlight(label, q) {
          if (!q) {
            return esc(label);
          }
          const i = label.toLowerCase().indexOf(q);
          if (i < 0) {
            return esc(label);
          }
          return (
            esc(label.slice(0, i)) +
            "<mark>" + esc(label.slice(i, i + q.length)) + "</mark>" +
            esc(label.slice(i + q.length))
          );
        }

        function buildItems() {
          const items = [];

          document.querySelectorAll("#sidebar .nav-group").forEach(function (group) {
            const title = group.querySelector(".nav-group-title");
            const hint = title ? title.textContent.trim() : "Menu";
            group.querySelectorAll(".nav-link").forEach(function (a) {
              const span = a.querySelector("span");
              const icon = a.querySelector("i");
              items.push({
                group: "Navigasi",
                label: span ? span.textContent.trim() : a.textContent.trim(),
                hint: hint,
                icon: icon ? icon.className : "fas fa-circle",
                href: a.getAttribute("href"),
                keywords: ""
              });
            });
          });

          const dark = root.classList.contains("dark-mode");
          const collapsed = root.classList.contains("sidebar-collapsed");
          const actions = [
            { label: "Tambah Muzakki", icon: "fas fa-user-plus", href: "/muzakki/create", keywords: "baru input catat bayar zakat" },
            { label: "Tambah Mustahik", icon: "fas fa-people-group", href: "/mustahik/create", keywords: "baru penerima" },
            { label: "Tambah RT", icon: "fas fa-house-circle-check", href: "/rt?new=1", keywords: "baru rukun tetangga ketua" },
            { label: "Tambah RW", icon: "fas fa-building", href: "/rw?new=1", keywords: "baru rukun warga ketua" },
            { label: "Buat Distribusi Baru", icon: "fas fa-share-nodes", href: "/distribusi/create", keywords: "salurkan bagikan" },
            { label: "Profil Saya", icon: "fas fa-user", href: "/users/profile", keywords: "akun nomor wa password" },
            {
              label: dark ? "Ganti ke Mode Terang" : "Ganti ke Mode Gelap",
              icon: dark ? "fas fa-sun" : "fas fa-moon",
              keywords: "tema dark light gelap terang",
              run: function () { window.toggleTheme(); }
            }
          ];

          if (isDesktop()) {
            actions.push({
              label: collapsed ? "Tampilkan Sidebar" : "Sembunyikan Sidebar",
              icon: "fas fa-angles-left",
              keywords: "menu panel samping ikon",
              run: toggleCollapse
            });
          }

          actions.push({
            label: "Keluar",
            icon: "fas fa-right-from-bracket",
            keywords: "logout sign out",
            run: function () {
              confirmLogout();
            }
          });

          actions.forEach(function (a) {
            a.group = "Aksi cepat";
            a.hint = "Aksi cepat";
            items.push(a);
          });

          return items;
        }

        function score(item, q) {
          const label = item.label.toLowerCase();
          if (label.indexOf(q) === 0) return 0;
          if (label.indexOf(" " + q) > -1) return 1;
          if (label.indexOf(q) > -1) return 2;
          if ((item.hint + " " + item.keywords).toLowerCase().indexOf(q) > -1) return 3;
          return -1;
        }

        function setActive(index, scroll) {
          const opts = listEl.querySelectorAll(".cmdk-item");
          if (!opts.length) {
            input.removeAttribute("aria-activedescendant");
            return;
          }
          active = (index + opts.length) % opts.length;
          opts.forEach(function (opt, n) {
            opt.classList.toggle("active", n === active);
            opt.setAttribute("aria-selected", n === active ? "true" : "false");
          });
          input.setAttribute("aria-activedescendant", opts[active].id);
          if (scroll !== false) {
            opts[active].scrollIntoView({ block: "nearest" });
          }
        }

        function render() {
          const q = input.value.trim().toLowerCase();
          let html = "";
          shown = [];

          ["Navigasi", "Aksi cepat"].forEach(function (groupName) {
            const rows = all
              .filter(function (item) { return item.group === groupName; })
              .map(function (item) { return { item: item, s: q ? score(item, q) : 0 }; })
              .filter(function (row) { return row.s >= 0; });

            if (q) {
              rows.sort(function (a, b) { return a.s - b.s; });
            }
            if (!rows.length) {
              return;
            }

            html += '<div class="cmdk-group" role="presentation">' + esc(groupName) + "</div>";
            rows.forEach(function (row) {
              const idx = shown.length;
              shown.push(row.item);
              html +=
                '<div class="cmdk-item" role="option" id="cmdk-opt-' + idx + '" data-index="' + idx + '">' +
                '<span class="cmdk-item-icon"><i class="' + esc(row.item.icon) + '"></i></span>' +
                '<span class="cmdk-item-label">' + highlight(row.item.label, q) + "</span>" +
                '<span class="cmdk-item-hint">' + esc(row.item.hint) + "</span></div>";
            });
          });

          listEl.innerHTML = shown.length
            ? html
            : '<div class="cmdk-empty">Tidak ada hasil untuk “' + esc(input.value.trim()) + "”</div>";
          setActive(0, false);
        }

        function isOpen() {
          return !!cmdk && cmdk.classList.contains("open");
        }

        function openPalette() {
          if (!cmdk || !input || !listEl) {
            return;
          }
          lastFocus = document.activeElement;
          all = buildItems();
          input.value = "";
          cmdk.classList.add("open");
          cmdk.setAttribute("aria-hidden", "false");
          document.body.classList.add("cmdk-open");
          hideTip();
          render();
          input.focus();
        }

        function closePalette() {
          if (!isOpen()) {
            return;
          }
          cmdk.classList.remove("open");
          cmdk.setAttribute("aria-hidden", "true");
          document.body.classList.remove("cmdk-open");
          if (lastFocus && lastFocus.focus) {
            try { lastFocus.focus(); } catch (error) { /* ignore */ }
          }
        }

        function runItem(item) {
          if (!item) {
            return;
          }
          closePalette();
          if (item.run) {
            item.run();
          } else if (item.href) {
            window.location.href = item.href;
          }
        }

        if (cmdk && input && listEl) {
          if (trigger) {
            trigger.addEventListener("click", openPalette);
          }

          input.addEventListener("input", render);

          input.addEventListener("keydown", function (e) {
            if (e.key === "ArrowDown") {
              e.preventDefault();
              setActive(active + 1);
            } else if (e.key === "ArrowUp") {
              e.preventDefault();
              setActive(active - 1);
            } else if (e.key === "Enter") {
              e.preventDefault();
              runItem(shown[active]);
            } else if (e.key === "Tab") {
              e.preventDefault();
            }
          });

          listEl.addEventListener("mousemove", function (e) {
            const el = e.target.closest(".cmdk-item");
            if (el) {
              const i = Number(el.dataset.index);
              if (i !== active) {
                setActive(i, false);
              }
            }
          });

          listEl.addEventListener("click", function (e) {
            const el = e.target.closest(".cmdk-item");
            if (el) {
              runItem(shown[Number(el.dataset.index)]);
            }
          });

          cmdk.addEventListener("click", function (e) {
            if (e.target.hasAttribute("data-cmdk-close")) {
              closePalette();
            }
          });
        }

        document.addEventListener("keydown", function (e) {
          const key = (e.key || "").toLowerCase();

          if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && key === "k") {
            if (!cmdk) {
              return;
            }
            e.preventDefault();
            if (isOpen()) {
              closePalette();
            } else {
              openPalette();
            }
            return;
          }

          if (key === "escape") {
            if (isOpen()) {
              closePalette();
              return;
            }

            const sidebar = document.getElementById("sidebar");
            if (sidebar && sidebar.classList.contains("show")) {
              toggleSidebar();
            }
          }
        });
      })();

      window.addEventListener("resize", function () {
        if (window.innerWidth > 768) {
          const sidebar = document.getElementById("sidebar");
          const overlay = document.getElementById("sidebarOverlay");
          if (sidebar && sidebar.classList.contains("show")) {
            sidebar.classList.remove("show");
            overlay.classList.remove("show");
          }
          document.body.classList.remove("sidebar-open");
        }
      });

      document.addEventListener("DOMContentLoaded", function () {
        applyTheme(getPreferredTheme());

        const toggleButton = document.getElementById("themeToggleAdmin");
        if (toggleButton) {
          toggleButton.addEventListener("click", toggleTheme);
        }

        setTimeout(function () {
          const flashMessages = document.querySelectorAll(".bg-green-100, .bg-red-100");
          flashMessages.forEach(function (message) {
            message.style.transition = "opacity 0.5s";
            message.style.opacity = "0";
            setTimeout(() => message.remove(), 500);
          });
        }, 5000);

        const sidebarLinks = document.querySelectorAll("#sidebar .nav-link");
        sidebarLinks.forEach(function (link) {
          link.addEventListener("click", function () {
            if (window.innerWidth > 768) {
              return;
            }

            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            if (sidebar) {
              sidebar.classList.remove("show");
            }
            if (overlay) {
              overlay.classList.remove("show");
            }
            document.body.classList.remove("sidebar-open");
          });
        });
      });

      if (window.matchMedia) {
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const handleThemeChange = function () {
          if (getStoredTheme()) {
            return;
          }
          applyTheme(mediaQuery.matches ? "dark" : "light");
        };

        if (mediaQuery.addEventListener) {
          mediaQuery.addEventListener("change", handleThemeChange);
        } else if (mediaQuery.addListener) {
          mediaQuery.addListener(handleThemeChange);
        }
      }
    </script>
  </body>
</html>
